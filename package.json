  "devDependencies": {
    "fvtt-types": "npm:@league-of-foundry-developers/foundry-vtt-types@latest",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-scss": "^4.0.0",
    "sass": "^1.79.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@types/jquery": "^3.5.30"
  }
}